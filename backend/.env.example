# Backend environment example
# Copy to backend/.env and fill with your real values

# --- App ---
NODE_ENV=development
JWT_SECRET=change_me
JWT_EXPIRES_IN=12h
FRONTEND_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=petit
DB_TIMEZONE=local

# Alternative: single connection string (recommended for cloud DBs)
# Example:
# DB_URL=postgresql://user:pass@host:5432/petit
# DB_URL=

# Local PostgreSQL usually doesn't require TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Image Storage ---
# local (default): stores files in backend/public/uploads and serves from /uploads
# s3: stores files in object storage (S3/R2/Spaces) and saves absolute URLs in DB
IMAGE_STORAGE_DRIVER=local

# Base public URL used to build final image URLs when IMAGE_STORAGE_DRIVER=s3
# Example (R2 custom domain): https://cdn.tu-dominio.com
# Example (S3): https://my-bucket.s3.amazonaws.com
IMAGE_STORAGE_PUBLIC_BASE_URL=

# Optional key prefix in bucket (defaults to "uploads")
IMAGE_STORAGE_PREFIX=uploads

# S3 / S3-compatible credentials (required when IMAGE_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Email notifications ---
# Enable/disable sending
MAIL_ENABLED=true

# Who receives the notifications (store owner email).
MAIL_TO=[EMAIL_ADDRESS]

# From address (must match SMTP_USER for Gmail App Passwords)
MAIL_FROM=[EMAIL_ADDRESS]

# Option 1 (RECOMMENDED): Resend API (HTTPS — works on Railway/cloud)
# Sign up at https://resend.com (free: 100 emails/day)
# Create an API key in the dashboard
# No phone verification needed, no DNS setup needed for testing
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: SMTP (local dev only — Railway blocks SMTP ports)
# If you use Gmail, use an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=app_password_here

# --- Correo Argentino ---
# Peso estimado del paquete en gramos (joyería = caja pequeña ~300g).
CORREO_AR_DEFAULT_WEIGHT_GRAMS=300

# Código postal de origen (dónde está el negocio).
CORREO_AR_ORIGIN_POSTAL_CODE=5000

# ── Opción A: Tabla de tarifas (sin credenciales) ───────────
# Precios base por zona (Encomienda Clásica 2025, ajustar según inflación).
# Zona 1: local / AMBA / misma región
# Zona 2: hasta ~500 km
# Zona 3: hasta ~1000 km
# Zona 4: Patagonia / todo el país
CORREO_AR_BASE_COST_ZONE_1=4000
CORREO_AR_BASE_COST_ZONE_2=5500
CORREO_AR_BASE_COST_ZONE_3=6500
CORREO_AR_BASE_COST_ZONE_4=8500

# ── Opción B: API MiCorreo (credenciales comerciales) ───────
# Solicitar credenciales en: https://www.correoargentino.com.ar/micorreo/
# Cuando estas variables estén presentes, se usa la API real.
CORREO_AR_CLIENT_ID=
CORREO_AR_CLIENT_SECRET=
# qa = ambiente de testing, prod = producción (default)
CORREO_AR_ENV=prod
